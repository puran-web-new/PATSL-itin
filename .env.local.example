# Database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Admin protection. Set a long random value and use it in the admin console.
ADMIN_ACCESS_TOKEN=replace_with_long_random_admin_token

# Public app URL used for redirects and Square webhook verification.
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# Square payment integration. Use sandbox credentials until launch.
SQUARE_ACCESS_TOKEN=replace_with_square_access_token
SQUARE_LOCATION_ID=replace_with_square_location_id
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=replace_with_square_webhook_signature_key
SQUARE_WEBHOOK_URL=https://your-project.vercel.app/api/payments/webhook

# Optional cron guard. Vercel Cron also sends an Authorization header when CRON_SECRET is set.
CRON_SECRET=replace_with_long_random_cron_secret

# Identity document storage. Create a Vercel Blob store (Storage tab in the Vercel
# dashboard) and it will inject BLOB_READ_WRITE_TOKEN automatically in Production/Preview.
# For local dev, copy the token from the store's ".env.local" tab.
BLOB_READ_WRITE_TOKEN=replace_with_vercel_blob_read_write_token

# Future OCR / document-intelligence integration (optional).
GCP_PROJECT_ID=
GCP_LOCATION=us
GCP_PROCESSOR_ID=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=

# Firm profile — auto-fills the Certified Acceptance Agent section on every case
# (business name, EIN, PTIN, office code, reviewer name/title) so staff never
# retype it per client. Leave EIN/PTIN unset locally; set them as real secrets
# in Vercel's Production environment only.
CAA_BUSINESS_NAME="Puran Accounting & Tax Solution Lab"
CAA_EIN=
CAA_PTIN=
CAA_OFFICE_CODE=
CAA_REVIEWER_NAME="Puran Ramratan"
CAA_REVIEWER_TITLE="Certified Acceptance Agent"
CAA_PHONE=
CAA_EMAIL=
CAA_ADDRESS=
